# Hey Broski - Environment Configuration

# App
HEYBROSKI_ENV=development
HEYBROSKI_DATA_DIR=./.hey-broski
HEYBROSKI_DEMO_MODE=true
# Model inference is required for chat. Setting this false disables chat answers.
# The ollama-model service pulls the configured model on first startup.
HEYBROSKI_USE_OLLAMA=true
HEYBROSKI_API_BASE_URL=http://localhost:8000
HEYBROSKI_WEB_BASE_URL=http://localhost:3000

# Frontend/backend routing
# Browser calls Next.js through /api; Next.js proxies to FastAPI.
# Native development uses localhost. Compose overrides the web container's URL.
NEXT_PUBLIC_API_BASE_URL=/api
API_BASE_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./heybroski.db
LANCEDB_PATH=./.hey-broski/lancedb

# LLM / Ollama
# Native development: Ollama on this computer.
# Docker Compose overrides this inside the API container with the host gateway.
OLLAMA_BASE_URL=http://127.0.0.1:11434
HEYBROSKI_CHAT_MODEL=qwen3:4b
HEYBROSKI_EMBEDDING_MODEL=nomic-embed-text
HEYBROSKI_LLM_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_NUM_PREDICT=160

# Security
HEYBROSKI_TOKEN_STORAGE=keyring
HEYBROSKI_FALLBACK_TOKEN_ENCRYPTION_KEY=change-me-only-for-local-dev

# Gmail developer mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/accounts/gmail/callback

# Microsoft developer mode
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/accounts/outlook/callback

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
HEYBROSKI_N8N_WEBHOOK_SECRET=local-dev-secret

# Feature flags
FEATURE_GMAIL_CONNECTOR=false
FEATURE_OUTLOOK_CONNECTOR=false
FEATURE_LOCAL_DOCUMENTS=true
FEATURE_N8N=true
FEATURE_MCP=true
FEATURE_TAURI=false
